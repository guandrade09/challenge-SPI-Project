# Copie para .env e preencha com valores reais. .env nunca deve ser commitado
# (já está no .gitignore da raiz).

# Chave da API do Ollama Cloud (https://ollama.com) usada pelo chat IA.
# Gere a sua em https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Opcionais — só defina se precisar sobrescrever os defaults do código:
# OLLAMA_CLOUD_URL=https://ollama.com/api/chat
# OLLAMA_MODEL=gpt-oss:120b
